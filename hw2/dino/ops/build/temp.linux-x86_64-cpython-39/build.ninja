ninja_required_version = 1.3
cxx = /mnt/facesim/Chiikawa/conda-envs/detection/bin/x86_64-conda-linux-gnu-c++
nvcc = /mnt/facesim/Chiikawa/conda-envs/detection/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /mnt/facesim/Chiikawa/conda-envs/detection/include -I/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/include -L/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/lib -L/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/lib/stubs -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /mnt/facesim/Chiikawa/conda-envs/detection/include -I/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/include -L/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/lib -L/mnt/facesim/Chiikawa/conda-envs/detection/targets/x86_64-linux/lib/stubs -fPIC -DWITH_CUDA -I/mnt/M3_Lab/Chiikawa/detection/DINO/models/dino/ops/src -I/mnt/facesim/Chiikawa/conda-envs/detection/lib/python3.9/site-packages/torch/include -I/mnt/facesim/Chiikawa/conda-envs/detection/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/mnt/facesim/Chiikawa/conda-envs/detection/include -I/mnt/facesim/Chiikawa/conda-envs/detection/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -std=c++17
cuda_cflags = -DWITH_CUDA -I/mnt/M3_Lab/Chiikawa/detection/DINO/models/dino/ops/src -I/mnt/facesim/Chiikawa/conda-envs/detection/lib/python3.9/site-packages/torch/include -I/mnt/facesim/Chiikawa/conda-envs/detection/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/mnt/facesim/Chiikawa/conda-envs/detection/include -I/mnt/facesim/Chiikawa/conda-envs/detection/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=MultiScaleDeformableAttention -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 -ccbin /mnt/facesim/Chiikawa/conda-envs/detection/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







