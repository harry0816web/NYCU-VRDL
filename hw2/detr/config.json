{
    "lr": 1e-4,
    "lr_backbone": 1e-5,
    "batch_size": 8,
    "weight_decay": 1e-4,
    "epochs": 30,
    "lr_drop": 20,
    "clip_max_norm": 0.1,

    "num_classes": 11,
    "num_queries": 30,

    "backbone": "resnet50",
    "dilation": false,
    "position_embedding": "sine",

    "enc_layers": 3,         
    "dec_layers": 3,        
    "dim_feedforward": 512,  
    "hidden_dim": 128,       
    "dropout": 0.2,         
    "nheads": 4,            
    "pre_norm": false,

    "aux_loss": true,

    "set_cost_class": 1,
    "set_cost_bbox": 5,
    "set_cost_giou": 2,

    "bbox_loss_coef": 5,
    "giou_loss_coef": 2,
    "eos_coef": 0.1,

    "data_path": "../data",
    "train_json": "train.json",
    "valid_json": "valid.json",

    "device": "cuda",
    "seed": 42,
    "num_workers": 4,
    "output_dir": "./output",
    "resume": ""
}
